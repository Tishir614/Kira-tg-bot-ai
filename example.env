# ==============================
# KiraBot 1.1.0 configuration
# ==============================

# --- Telegram (required) ---
TOKEN=your_bot_token_here
# Strongly recommended: Telegram user ID of the bot owner.
OWNER_ID=0
# Destination that receives support tickets. Bot must be a member and allowed to post.
SUPPORT_CHAT_ID=@kira26481

# Optional Pyrogram helper. Leave BOTH empty if you do not need it.
API_ID=
API_HASH=

# Time / reminders / birthday events
BOT_TIMEZONE=Europe/Vilnius

# Persistent state. Relative paths are resolved from the project root.
DATA_DIR=static

# --- Logging / runtime protection ---
LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_RETENTION_DAYS=14
# Per-user dispatcher guard. Owner is exempt.
REQUEST_LIMIT=30
REQUEST_WINDOW_SECONDS=10
MAX_CONCURRENT_AI=4
MAX_CONCURRENT_DOWNLOADS=3
FILE_ANALYSIS_MAX_MB=20

# Optional Redis-backed FSM. Leave empty for in-memory FSM.
# Docker Compose injects redis://redis:6379/0 automatically.
FSM_REDIS_URL=

# Automatic SQLite backups. Set interval to 0 to disable scheduled backups.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- Local-only AI chain ---
# No cloud AI keys are required. Kira 1.1 routes simple prompts to a fast local
# model and complex prompts to a stronger one. On low-RAM servers ai_quality.sh
# automatically points both routes to the 2B model.
OLLAMA_BASE_URL=
OLLAMA_MODEL=hf.co/mradermacher/Qwen2.5-1.5B-Instruct-uncensored-GGUF:Q4_K_M
OLLAMA_FAST_MODEL=hf.co/mradermacher/Qwen2.5-1.5B-Instruct-uncensored-GGUF:Q4_K_M
OLLAMA_SMART_MODEL=
OLLAMA_MODELS=hf.co/mradermacher/Qwen2.5-1.5B-Instruct-uncensored-GGUF:Q4_K_M
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
AI_ADAPTIVE_ROUTING=1

# Circuit breaker: transient provider failures are skipped for this many seconds.
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_PROVIDER_TIMEOUT_SECONDS=28
AI_PROVIDER_ORDER=ollama
AI_LOCAL_ONLY=1
AI_QUALITY_FIRST=1
AI_FAST_MODE=1
AI_SMART_DIALOGUE=1
AI_DELIBERATE_MODE=1
AI_REVIEW_PASS=0
AI_HISTORY_MESSAGES=10
AI_HISTORY_MAX_CHARS=10000
AI_TEMPERATURE=0.68
AI_CREATIVE_TEMPERATURE=0.88
AI_RESEARCH_TEMPERATURE=0.22
AI_MAX_RESPONSE_TOKENS=700


# --- Crash recovery / watchdog ---
# 1 = after the same unhandled error repeats several times, Kira performs
# a bounded process restart. Docker restart: unless-stopped brings it back.
# Runtime source code is NEVER rewritten automatically.
AUTO_RECOVERY_RESTART=1

# --- Local neural TTS: Piper (no API keys) ---
TTS_VOICE_RU=ru_RU-irina-medium
TTS_VOICE_EN=en_US-lessac-medium
PIPER_DATA_DIR=/app/static/piper

# --- Local image generation: ComfyUI (no API keys) ---
LOCAL_IMAGE_BASE_URL=http://comfyui:8188
COMFYUI_VERSION=v0.36.0
COMFYUI_CHECKPOINT=DreamShaper_8_pruned.safetensors
COMFYUI_MODEL_URL=https://huggingface.co/Lykon/DreamShaper/resolve/main/DreamShaper_8_pruned.safetensors?download=true
LOCAL_IMAGE_WIDTH=512
LOCAL_IMAGE_HEIGHT=512
LOCAL_IMAGE_STEPS=24
LOCAL_IMAGE_CFG_SCALE=7.0
LOCAL_IMAGE_TIMEOUT=1200

# --- Kira 1.0 local speech recognition (whisper.cpp, no API key) ---
LOCAL_STT_BASE_URL=http://local-stt:8080
LOCAL_STT_MODEL_FILE=ggml-base.bin
LOCAL_STT_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin?download=true
LOCAL_STT_THREADS=4
LOCAL_STT_LANGUAGE=auto

# Public HTTPS URL for the single Telegram Mini App (profile/shop/D&D/commands/memory)
KIRA_WEBAPP_URL=https://example.com/kira
KIRA_DISABLED_PLUGINS=

# --- Kira 1.1 social/media integrations ---
# No account cookies are read automatically. Public YouTube/TikTok/Twitch links
# use yt-dlp; search uses ytsearch/DDGS. Optional platform API keys can be added
# later without changing the core.
MEDIA_MAX_DOWNLOAD_MB=49

# Local multimodal vision (llama.cpp/Kimi-VL)
KIRA_VISION_URL=http://host.docker.internal:8091
KIRA_VISION_MODEL=ssweens/Kimi-VL-A3B-Instruct-GGUF:Q4_K_M
KIRA_ALLOW_PROFANITY=1

# --- Image providers (2.5.0) ---
# Порядок: Perchance furry-ai (https://perchance.org/furry-ai), затем локальный ComfyUI.
IMAGE_PROVIDERS=perchance,comfyui
PERCHANCE_ENABLED=1
PERCHANCE_RESOLUTION=512x768
